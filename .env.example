# Приклад без секретів. Скопіюйте в окремий .env; замініть CHANGE_ME.
PROJECT2_ENV=development
DATABASE_URL=postgresql+psycopg://project2_dev:CHANGE_ME@127.0.0.1:5432/project2_dev
PROJECT2_AUTH_ENABLED=1
# Застарілі dev/admin bypass не надають доступу.
PROJECT2_DOCUMENT_STORAGE=C:/project2-data/development/documents
PROJECT2_PHOTO_STORAGE=C:/project2-data/development/photos
PROJECT2_TEMP_STORAGE=C:/project2-data/development/temporary
PROJECT2_EXPORT_STORAGE=C:/project2-data/development/exports
PROJECT2_BACKUP_STORAGE=C:/project2-data/development/backups
# Security 1.5: opt-in JSON outside Git; configure keys, private staging and OS scheduler first.
# PROJECT2_BACKUP_CONFIG=C:/project2-secrets/backup.json
PROJECT2_POOL_SIZE=5
PROJECT2_MAX_OVERFLOW=5
PROJECT2_POOL_TIMEOUT=20
STAFF_SIGNING_KEY=REPLACE_WITH_RANDOM_KEY
PROJECT2_AUTH_ALLOW_LOCAL_HTTP=1
# MFA 1.3: generate and back up persistent keys outside Git before initialization.
# JSON mapping key ID -> Fernet key (base64 of 32 random bytes). No default key.
PROJECT2_MFA_KEYS={"primary":"REPLACE_WITH_PERSISTENT_FERNET_KEY"}
PROJECT2_MFA_CURRENT_KEY=primary
PROJECT2_WEBAUTHN_RP_ID=localhost
PROJECT2_WEBAUTHN_ORIGINS=["http://localhost:8001"]
