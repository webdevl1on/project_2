# Приклад без секретів. Скопіюйте в окремий .env; замініть CHANGE_ME.
PROJECT2_ENV=testing
DATABASE_URL=postgresql+psycopg://project2_ci:CHANGE_ME@127.0.0.1:5432/project2_ci
PROJECT2_AUTH_ENABLED=1
# Застарілі dev/admin bypass не надають доступу.
PROJECT2_DOCUMENT_STORAGE=C:/project2-data/testing/documents
PROJECT2_PHOTO_STORAGE=C:/project2-data/testing/photos
PROJECT2_TEMP_STORAGE=C:/project2-data/testing/temporary
PROJECT2_EXPORT_STORAGE=C:/project2-data/testing/exports
PROJECT2_BACKUP_STORAGE=C:/project2-data/testing/backups
PROJECT2_POOL_SIZE=5
PROJECT2_MAX_OVERFLOW=5
PROJECT2_POOL_TIMEOUT=20
STAFF_SIGNING_KEY=REPLACE_WITH_RANDOM_KEY
PROJECT2_TEST_DATABASE_URL=postgresql+psycopg://project2_ci:CHANGE_ME@127.0.0.1:5432/project2_ci
