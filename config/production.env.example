# Приклад без секретів. Скопіюйте в окремий .env; замініть CHANGE_ME.
PROJECT2_ENV=production
DATABASE_URL=postgresql+psycopg://project2_prod:CHANGE_ME@127.0.0.1:5432/project2_prod
PROJECT2_AUTH_ENABLED=1
# Застарілі dev/admin bypass не надають доступу.
PROJECT2_DOCUMENT_STORAGE=C:/project2-data/production/documents
PROJECT2_PHOTO_STORAGE=C:/project2-data/production/photos
PROJECT2_TEMP_STORAGE=C:/project2-data/production/temporary
PROJECT2_EXPORT_STORAGE=C:/project2-data/production/exports
PROJECT2_BACKUP_STORAGE=C:/project2-data/production/backups
# Security 1.5: provision a private external JSON, independent keys and OS scheduling.
# PROJECT2_BACKUP_CONFIG=C:/project2-secrets/production-backup.json
PROJECT2_POOL_SIZE=5
PROJECT2_MAX_OVERFLOW=5
PROJECT2_POOL_TIMEOUT=20
STAFF_SIGNING_KEY=REPLACE_WITH_RANDOM_KEY

# Security 1.3: persistent, externally backed-up keys; never commit real values.
PROJECT2_MFA_KEYS={"primary":"REPLACE_WITH_PERSISTENT_FERNET_KEY"}
PROJECT2_MFA_CURRENT_KEY=primary
PROJECT2_WEBAUTHN_RP_ID=personnel.example.invalid
PROJECT2_WEBAUTHN_ORIGINS=["https://personnel.example.invalid"]
